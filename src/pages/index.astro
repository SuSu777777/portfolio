---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { PROFILE, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
const projects = await getCollection('projects');
const posts = (await getCollection('blog')).sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0,3);
const date = (value: Date) => new Intl.DateTimeFormat('en-US',{year:'numeric',month:'2-digit',day:'2-digit'}).format(value);
---
<!doctype html>
<html lang="en">
<head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /></head>
<body>
  <Header />
  <main>
    <section class="hero shell" id="about">
      <div class="hero-copy">
        <div class="availability"><span class="dot"></span> WONGFENGCHEN'S SPACE</div>
        <h1>Build.<br /><em>Learn.</em><br />Document.</h1>
        <p>Hi, I’m Wongfengchen. I write about the problems I solve, the things I learn, and the projects I build.</p>
        <div class="hero-actions"><a class="button primary" href="/blog/">Read the blog <span>↗</span></a><a class="button secondary" href="#projects">View projects <span>↓</span></a></div>
      </div>
      <div class="hero-art" aria-hidden="true"><div class="art-top"><span>~/wongfengchen</span><span>● ● ●</span></div><div class="art-code"><span class="line-num">01</span><span class="syntax-purple">const</span> developer = {<br /><span class="line-num">02</span>&nbsp;&nbsp;name: <span class="syntax-yellow">'Wongfengchen'</span>,<br /><span class="line-num">03</span>&nbsp;&nbsp;focus: <span class="syntax-yellow">'Build & Learn'</span>,<br /><span class="line-num">04</span>&nbsp;&nbsp;curious: <span class="syntax-blue">true</span>,<br /><span class="line-num">05</span>};<br /><span class="line-num">06</span><br /><span class="line-num">07</span><span class="syntax-green">// write. ship. repeat.</span><span class="cursor">▋</span></div><div class="art-footer"><span>● portfolio.ts</span><span>UTF-8&nbsp;&nbsp; TypeScript</span></div></div>
    </section>
    <div class="marquee"><div class="shell"><span>DEVELOPMENT</span><span>✳</span><span>PROJECTS</span><span>✳</span><span>NOTES</span><span>✳</span><span>LEARNING IN PUBLIC</span></div></div>
    <section class="section shell" id="writing"><div class="section-heading"><div><span class="eyebrow">THE JOURNAL</span><h2>Recent writing</h2></div><a class="text-link" href="/blog/">All posts ↗</a></div><div class="post-list">{posts.map(post => <a class="post-row" href={`/blog/${post.id}/`}><span class="post-date">{date(post.data.pubDate)}</span><div><h3>{post.data.title}</h3><p>{post.data.description}</p></div><span class="post-arrow">↗</span></a>)}</div></section>
    <section class="section shell" id="projects"><div class="section-heading"><div><span class="eyebrow">SELECTED WORK</span><h2>Projects</h2></div><a class="text-link" href={PROFILE.github} target="_blank" rel="noopener noreferrer">Visit GitHub ↗</a></div><div class="project-grid">{projects.map((project,index) => <a class="project-card" href={project.data.href} target={project.data.href.startsWith('http') ? '_blank' : undefined} rel={project.data.href.startsWith('http') ? 'noopener noreferrer' : undefined}><div class="project-visual"><span class="project-index">0{index+1} / PROJECT</span><span class="project-icon">↗</span></div><div class="project-content"><h3>{project.data.title}</h3><p>{project.data.description}</p><div class="tags">{project.data.tags.map(tag => <span class="pill">{tag}</span>)}</div></div></a>)}</div></section>
    <section class="contact shell" id="contact"><div><span class="eyebrow">GET IN TOUCH</span><h2>Let’s talk.</h2><p>Have a project, an idea, or a question?<br />My inbox is open.</p></div><a class="contact-button" href={`mailto:${PROFILE.email}`}>{PROFILE.email} <span>↗</span></a></section>
  </main><Footer />
</body></html>
<style>
.hero{min-height:590px;display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:68px;padding-top:64px;padding-bottom:75px}.availability{display:inline-flex;align-items:center;gap:9px;color:var(--accent);font-size:11px;font-weight:700;letter-spacing:.16em}.dot{width:8px;height:8px;background:#4da486;border-radius:50%;box-shadow:0 0 0 4px #dcebe3}.hero h1{font-size:clamp(62px,7vw,104px);letter-spacing:-.085em;line-height:1.03;margin:22px 0 27px;font-weight:700}.hero h1 em{font-style:normal;color:var(--accent)}.hero-copy>p{max-width:490px;font-size:17px;color:var(--muted);line-height:1.8;margin:0 0 31px}.hero-actions{display:flex;flex-wrap:wrap;gap:10px}.button{padding:13px 18px;border-radius:8px;font-size:14px;font-weight:700;display:inline-flex;gap:25px;align-items:center}.primary{background:var(--ink);color:#fff}.primary:hover{color:#fff;background:var(--accent)}.secondary{border:1px solid var(--line);background:#fff}.hero-art{background:#202727;border:1px solid #374344;border-radius:16px;color:#e4ebdc;box-shadow:16px 20px 0 #dce8df,0 20px 50px #1b2d251a;transform:rotate(2deg);overflow:hidden;font-family:monospace;font-size:14px}.art-top,.art-footer{display:flex;justify-content:space-between;padding:12px 18px;color:#91a3a0;font-size:11px;background:#263131}.art-code{padding:50px 27px 58px;line-height:2.2;white-space:nowrap}.line-num{display:inline-block;color:#657671;width:35px}.syntax-purple{color:#c8aeff}.syntax-yellow{color:#e8ca87}.syntax-blue{color:#8ec7dc}.syntax-green{color:#7fa98c}.cursor{color:#8aca9a;margin-left:5px}.art-footer{background:#1a2222}.marquee{background:#e9efe8;border-block:1px solid #dde7dc;color:#547066}.marquee .shell{min-height:57px;display:flex;justify-content:space-between;align-items:center;font-size:11px;font-weight:700;letter-spacing:.18em}.marquee span:nth-child(even){color:#89aa9d;font-size:18px}.section{padding-top:92px;padding-bottom:20px}.project-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}.project-card{background:#fff;border:1px solid var(--line);border-radius:12px;overflow:hidden}.project-visual{height:195px;background:#e5eee9;display:flex;justify-content:space-between;padding:20px;color:var(--accent)}.project-icon{font-size:32px}.project-index{font-size:11px;font-weight:700;letter-spacing:.12em}.project-content{padding:23px}.project-content h3{margin:0 0 6px}.project-content p{color:var(--muted);margin:0 0 15px;font-size:14px}.tags{display:flex;gap:6px}.empty-project{border:1px dashed #b9c9c0;background:#f1f5f0;border-radius:14px;min-height:240px;display:flex;align-items:center;gap:30px;padding:34px}.empty-symbol{height:70px;width:70px;flex:none;border-radius:16px;background:#dfece2;display:grid;place-items:center;font-size:32px;color:var(--accent)}.empty-project h3{margin:0 0 4px;font-size:21px}.empty-project p{margin:0 0 13px;color:var(--muted);font-size:14px}.contact{margin-top:100px;margin-bottom:95px;border-radius:18px;background:#20362f;color:#fff;padding:49px 55px;display:flex;align-items:center;justify-content:space-between;gap:25px}.contact .eyebrow{color:#9bd2aa}.contact h2{font-size:36px;letter-spacing:-.055em;margin:5px 0}.contact p{color:#b9d1c4;margin:0;font-size:15px}.contact-button{background:#d5edda;color:#18372b;border-radius:8px;padding:15px 18px;display:flex;gap:25px;font-size:14px;font-weight:700;white-space:nowrap}.contact-button:hover{background:#fff;color:#18372b}@media(max-width:800px){.hero{grid-template-columns:1fr;min-height:auto;gap:45px;padding-top:55px}.hero-art{max-width:580px;transform:none}.marquee span:nth-last-child(-n+2){display:none}.contact{flex-direction:column;align-items:flex-start}}@media(max-width:520px){.hero h1{font-size:62px}.art-code{font-size:11px;padding:35px 15px}.marquee .shell{font-size:9px}.section{padding-top:66px}.empty-project{align-items:flex-start;padding:25px;gap:16px}.empty-symbol{width:45px;height:45px;font-size:22px}.contact{margin-top:70px;margin-bottom:65px;padding:30px 24px}.contact h2{font-size:30px}.contact-button{white-space:normal;width:100%;justify-content:space-between}}
</style>
